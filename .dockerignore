# Keep the build context small and the image reproducible. Anything that is
# generated, host-specific, or irrelevant to compiling stays out -- a stale
# local build/ directory leaking into the image is a classic source of
# "works in the container, not on CI".

.git
.gitattributes
.gitignore
.github

# Local build output
build/
.build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
compile_commands.json
*.o
*.a
*.so
*.exe

# Generated datasets -- regenerate with tools/gen_input.py instead of shipping
# tens of megabytes into every layer.
**/bench/data/
**/bench/results/
output.txt
*.actual
job-*.out
job-*.err

# Not needed to build or run. The ** forms matter now that examples carry their
# own docs and Makefile: a top-level-anchored `docs/` would not exclude
# examples/hybrid-object-matching/docs/, which the builder stage copies whole.
**/docs/
**/Makefile
scripts/
LICENSE
**/*.md

# Editors, OS, Python
.vscode/
.idea/
.claude/
__pycache__/
*.pyc
.venv/
.DS_Store
Thumbs.db
